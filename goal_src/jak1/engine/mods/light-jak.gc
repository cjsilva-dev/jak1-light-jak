;;-*-Lisp-*-
(in-package goal)

;; name: light-jak.gc
;; name in dgo: light-jak
;; dgos: GAME

;; LIGHT JAK IN JAK 1, the form: the final boss's white-eco Jak (jak-white-ag, the model from the ending) drawn in
;; place of the player. jak-white has Jak's 84 bones in a different order and only an idle animation, so it is a
;; puppet: Jak keeps animating as normal, and right after his joint math each frame (target-joint-callback-pc,
;; pc-anim-util.gc) every bone's world transform is copied BY JOINT NAME onto the puppet (the bind poses match, so a
;; plain copy is exact). Jak's own mesh is skipped in the foreground draw (drawable.gc, (-> *lj* hidden-proc)) but his
;; joint math keeps running, which the hidden flag would stop. The mesh reaches the renderer through the decompiler's
;; common_art_groups (decompiler/config/jak1/jak1_config.jsonc), the art group through GAME.CGO (dgos/game.gd).
;;
;; The puppet (and the wings) are children of Jak, spawned with him in init-target (logic-target.gc): they die with
;; him and come back with him, so nothing polls for them. R3 toggles the form (lj-form-input, runs-every-frame).

(defskelgroup *lj-puppet-sg*
  jak-white
  jak-white-lod0-jg
  jak-white-idle-ja
  ((jak-white-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4))

(defconstant LJ_MAX_NODES 96)

(deftype lj-puppet (process-drawable)
  ((bone-map   int16 96) ;; for each of our nodes, Jak's node with the same joint name (-1 = none)
   (node-count int32)
   (mapped?    symbol)
   (shown?     symbol))   ;; drawn last frame (the show/hide transitions are made on the change)
  (:states
   lj-puppet-idle))

;; ---- the glow: the ending's own white-eco aura (sage-finalboss-part.gc parts 2930 / 2929, common "effects"
;; textures), tinted Light-Jak blue-white, on new ids (parts 3500+, group 1000; the game's top out at 2968 / 708).
;; The ending's sparkle "pop" function is tied to the boss arena's height, so the sparkles here just rise and fade.
(defpartgroup group-lj-aura
  :id 1000
  :duration (seconds 3)
  :flags (use-local-clock)
  :bounds (static-bspherem 0 0 0 64)
  :parts ((sp-item 3500) (sp-item 3502)))

(defpart 3500
  :init-specs
  ((:texture (bigpuff effects))
   (:num 0.4 0.3)
   (:x (meters -0.001) (meters 0.002))
   (:y (meters -0.001) (meters 0.002))
   (:z (meters -0.001) (meters 0.002))
   (:scale-x (meters 1.2) (meters 0.4))
   (:rot-z (degrees 0) (degrees 360))
   (:scale-y :copy scale-x)
   (:r 170.0 40.0)
   (:g 200.0 40.0)
   (:b 255.0)
   (:a 0.0)
   (:scalevel-x (meters 0.004))
   (:rotvel-z (degrees -0.3) (degrees 0.6))
   (:scalevel-y :copy scalevel-x)
   (:fade-a 0.16)
   (:accel-y (meters 0) (meters 0.00033333333))
   (:timer (seconds 0.6))
   (:flags (bit2 bit3 bit14))
   (:next-time (seconds 0.2) (seconds 0.05))
   (:next-launcher 3501)))

(defpart 3501
  :init-specs ((:fade-a -0.16)))

(defpart 3502
  :init-specs
  ((:texture (hotdot effects))
   (:num 0.5 1.0)
   (:scale-x (meters 0.08) (meters 0.12))
   (:scale-y :copy scale-x)
   (:r 210.0 45.0)
   (:g 225.0 30.0)
   (:b 255.0)
   (:a 48.0 64.0)
   (:vel-y (meters 0.01) (meters 0.02))
   (:scalevel-x (meters -0.0005))
   (:scalevel-y :copy scalevel-x)
   (:accel-y (meters 0.0005) (meters 0.0005))
   (:friction 0.9)
   (:timer (seconds 0.3) (seconds 0.4))
   (:flags (bit0 bit2 bit3 bit14))
   (:conerot-x (degrees 0) (degrees 360))
   (:conerot-y (degrees 0) (degrees 360))))

(defun lj-aura-burst ((pd process-drawable) (puffs int) (sparks int))
  "A burst of the aura around a process: the transformation, the superhero landing."
  (dotimes (i puffs)
    (launch-particles (-> *part-id-table* 3500) (process-drawable-random-point! pd (new 'stack-no-clear 'vector))))
  (dotimes (i sparks)
    (launch-particles (-> *part-id-table* 3502) (process-drawable-random-point! pd (new 'stack-no-clear 'vector))))
  (none))

(defbehavior lj-puppet-build-map lj-puppet ((jak target))
  "For each of our nodes, Jak's node whose joint has the same name. Node 0 (the root, no joint) maps to 0."
  (let ((ours (-> self node-list))
        (his (-> jak node-list))
        (missing 0))
    (set! (-> self node-count) (min (-> ours length) LJ_MAX_NODES))
    (set! (-> self bone-map 0) 0)
    (countdown (k (+ (-> self node-count) -1))
      (let* ((i (+ k 1))
             (jt (-> ours data i joint))
             (found -1))
        (when jt
          (dotimes (j (-> his length))
            (let ((hj (-> his data j joint)))
              (if (and (< found 0) hj (string= (-> hj name) (-> jt name))) (set! found j)))))
        (if (< found 0) (+! missing 1))
        (set! (-> self bone-map i) found)))
    (if (> missing 0) (format 0 "light-jak: ~D of ~D puppet bones have no match on Jak~%" missing (-> self node-count))))
  (set! (-> self mapped?) #t)
  (none))

(defun lj-form-active? ()
  "Should the puppet stand in for Jak right now? Not with the form off, nor whenever the game hides Jak itself
   (cutscenes use their own Jak), nor during a death/warp dissolve: that counts down inside Jak's own draw and ends
   with 'death-end, so Jak must draw for it or a warp gate waits forever (2026-10-15)."
  (and (-> *lj* on?)
       *target*
       (nonzero? (-> *target* draw))
       (not (logtest? (-> *target* draw status) (draw-status hidden no-anim)))
       (zero? (-> *target* draw death-timer))))

(defun lj-eyes ((wj lj-puppet) (jak target))
  "Jak 1 draws eyes into a texture per eye slot (update-eyes, eye.gc), only for a slot whose process has the eye bit
   and was drawn. Jak is not drawn while the puppet stands in, so his slot would go black: the puppet's slot takes the
   puppet's own eye shaders and Jak's live eye data, with the iris and pupil scaled away (Light Jak's eyes glow white)."
  (let ((his-ctrl (-> jak draw mgeo header eye-ctrl))
        (our-ctrl (-> wj draw mgeo header eye-ctrl)))
    (when (and (nonzero? his-ctrl) (nonzero? our-ctrl))
      (let ((src (-> *eye-control-array* data (-> his-ctrl eye-slot)))
            (dst (-> *eye-control-array* data (-> our-ctrl eye-slot))))
        (when (!= src dst)
          (set! (-> dst left data 0 quad) (-> src left data 0 quad))
          (set! (-> dst left data 1 quad) (-> src left data 1 quad))
          (set! (-> dst right data 0 quad) (-> src right data 0 quad))
          (set! (-> dst right data 1 quad) (-> src right data 1 quad))
          (set! (-> dst level) (-> src level)))
        (set! (-> dst left data 1 x) 0.0)
        (set! (-> dst left data 1 y) 0.0)
        (set! (-> dst right data 1 x) 0.0)
        (set! (-> dst right data 1 y) 0.0)
        (set! (-> dst process) (process->handle wj))
        (set! (-> dst shaders) (the-as (inline-array adgif-shader) (-> our-ctrl iris-shader)))
        (logior! (-> wj skel status) (janim-status eye)))))
  (none))

(define-extern lj-wings-place (function target none)) ;; light-wings.gc

(defun lj-form-postbind ((jak target))
  "From Jak's postbind (target-joint-callback-pc): after his joint math, before the draw. Copy his pose onto the puppet
   and place the wings. This is the one per-frame job of the form, and it has to be: it follows the animation."
  (let ((wj (the-as lj-puppet (handle->process (-> *lj* puppet)))))
    (when (and wj (-> wj shown?))
      (let ((dst (-> wj node-list))
            (src (-> jak node-list)))
        (dotimes (i (-> wj node-count))
          (let ((j (-> wj bone-map i)))
            (when (>= j 0)
              (matrix-copy! (-> dst data i bone transform) (-> src data j bone transform))
              (set! (-> dst data i bone scale quad) (-> src data j bone scale quad))))))
      (lj-eyes wj jak)
      ;; the renderer culls on origin + bounds
      (set! (-> wj root trans quad) (-> jak root trans quad))
      (set! (-> wj draw origin quad) (-> jak draw origin quad))
      (set! (-> wj draw light-index) (-> jak draw light-index))
      (vector*! (-> wj draw color-mult) (-> jak draw color-mult) (-> *lj-tune* mult))
      (set! (-> wj draw color-mult w) (-> jak draw color-mult w))
      (vector+! (-> wj draw color-emissive) (-> jak draw color-emissive) (-> *lj-tune* glow))
      (set! (-> wj draw color-emissive w) 0.0)))
  (lj-wings-place jak)
  (none))

(defbehavior lj-puppet-show! lj-puppet ((on? symbol))
  "The show/hide transition: the puppet's draw bits and which mesh the draw skips."
  (set! (-> self shown?) on?)
  (cond
    (on?
     (logclear! (-> self draw status) (draw-status hidden no-anim no-skeleton-update))
     (set! (-> *lj* hidden-proc) *target*))
    (else
     (logior! (-> self draw status) (draw-status hidden))
     (set! (-> *lj* hidden-proc) (the-as process-drawable #f))))
  (none))

(defstate lj-puppet-idle (lj-puppet)
  :trans
    (behavior ()
      (if (and (not (-> self mapped?)) *target*) (lj-puppet-build-map *target*))
      (let ((want (if (and (-> self mapped?) (lj-form-active?)) #t #f)))
        (if (!= want (-> self shown?)) (lj-puppet-show! want))
        ;; the aura is an emitter: it is fed every frame it shows, like any Jak 1 particle emitter
        (if (and want (nonzero? (-> self part)))
          (spawn (-> self part) (process-drawable-random-point! self (new 'stack-no-clear 'vector))))))
  :code
    (behavior ()
      (ja-channel-set! 1)
      (ja :group! jak-white-idle-ja :num! min)
      (loop (suspend))))

(defmethod deactivate ((this lj-puppet))
  (if (= (-> *lj* hidden-proc) *target*) (set! (-> *lj* hidden-proc) (the-as process-drawable #f)))
  ((method-of-type process-drawable deactivate) this)
  (none))

(defbehavior lj-puppet-init-by-other lj-puppet ()
  (set! (-> self root) (new 'process 'trsqv))
  (if *target* (set! (-> self root trans quad) (-> *target* root trans quad)))
  (initialize-skeleton self *lj-puppet-sg* '())
  (set! (-> self part) (create-launch-control (-> *part-group-id-table* 1000) self)) ;; group-lj-aura, by id
  (set! (-> self mapped?) #f)
  (set! (-> self shown?) #f)
  ;; never animated or joint-mathed itself: its bones are written by lj-form-postbind
  (logior! (-> self draw status) (draw-status hidden))
  (go lj-puppet-idle)
  (none))

(define-extern lj-wings-init-by-other (function none :behavior process-drawable)) ;; light-wings.gc
(define-extern lj-wings-spawn (function target none))
(define-extern lj-land! (function target none)) ;; light-flight.gc

(defun lj-form-spawn ((jak target))
  "At Jak's birth (init-target, after his skeleton): the puppet and the wings, as his children. A flight that was
   cut off by his death or a load is over too."
  (lj-reset!)
  (set! (-> *lj* hidden-proc) (the-as process-drawable #f))
  (let ((p (process-spawn lj-puppet :to jak)))
    (set! (-> *lj* puppet) (if p (ppointer->handle p) (the-as handle #f)))
    (if (not p) (format 0 "light-jak: no memory for the puppet~%")))
  (lj-wings-spawn jak)
  (none))

(defun lj-form-switch! ((on? symbol))
  "Light Jak on or off (R3). Switching on bursts the aura around him, with a rumble and a sound; switching off in
   mid-air ends the flight."
  (set! (-> *lj* on?) on?)
  (when *target*
    (cond
      (on?
       (cpad-set-buzz! (-> *cpad-list* cpads 0) 1 200 (seconds 0.3))
       (sound-play "blue-eco-on")
       (lj-aura-burst *target* 60 40))
      ((-> *lj* flying?) (lj-land! *target*))))
  (none))

(defun lj-form-input ()
  "Every frame (runs-every-frame): the R3 toggle. Input is the one thing that has to be polled."
  (if (cpad-pressed? 0 r3) (lj-form-switch! (not (-> *lj* on?))))
  (none))
