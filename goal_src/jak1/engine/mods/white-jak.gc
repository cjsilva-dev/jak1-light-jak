;;-*-Lisp-*-
(in-package goal)

;; name: white-jak.gc
;; name in dgo: white-jak
;; dgos: GAME

;; WHITE JAK (prototype): the final boss's white-eco Jak (jak-white-ag, the model from the ending) drawn in place
;; of the player. jak-white has the same 83 bones as Jak (eichar) in a different order and only an idle animation,
;; so it is a puppet: Jak keeps animating as normal, and right after his joint math each frame
;; (target-joint-callback-pc, pc-anim-util.gc) every bone's world transform is copied BY JOINT NAME onto the puppet's
;; skeleton. Jak's own mesh is skipped in the foreground draw (drawable.gc, *white-jak-hidden-proc*) but his joint math
;; keeps running, which the hidden flag would stop. The mesh reaches the renderer through the decompiler's
;; common_art_groups (decompiler/config/jak1/jak1_config.jsonc), the art group through GAME.CGO (dgos/game.gd).
;; R3 toggles it.

(defskelgroup *white-jak-sg*
  jak-white
  jak-white-lod0-jg
  jak-white-idle-ja
  ((jak-white-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4))

(define *white-jak-on?* #t)

;; apply the per-bone bind-pose correction (off = raw world-transform copy: arms/head came out twisted, 2026-10-15)
(define *white-jak-fix?* #t)

;; DEBUG: the puppet plays its own idle animation 2 m beside Jak instead of copying him (shows the mesh's own pose)
(define *white-jak-own-anim?* #f)

;; match bones by slot number instead of joint name (the bind-pose correction then pairs the same slots)
(define *white-jak-by-index?* #f) ;; by slot number = spikes (the mesh is skinned by name order), 2026-10-15

;; glow added on top of Jak's own lighting (the ending uses 0.5 grey), and a multiplier on the texture colour. The
;; white-eco textures + 0.5 grey read "kinda yellow" to Corey (2026-10-15): cut red/green, glow pale blue (Light Jak).
(define *white-jak-emissive* 0.5)
(define *white-jak-glow* (new 'static 'vector :x 0.3 :y 0.42 :z 0.85 :w 0.0))
(define *white-jak-mult* (new 'static 'vector :x 0.7 :y 0.82 :z 1.35 :w 1.0)) ;; "super golden" with 0.8/0.88/1.0 (Corey)

(deftype white-jak-globals (structure)
  ((handle handle) ;; the puppet. NOT a plain global: Jak 1 symbol values are 32 bits and a handle is 64 (process + pid);
                   ;; a (define *x* handle) kept only the process half, every lookup failed the pid check, and a new
                   ;; puppet was spawned each second until the actor heap ran out (2026-10-15)
   (retry  int32)))  ;; frames until the next spawn attempt

(define *white-jak* (new 'static 'white-jak-globals))
;; a zeroed handle is NOT empty (handle->process only treats #f as no process), so set it at load
(set! (-> *white-jak* handle) (the-as handle #f))
(set! (-> *white-jak* retry) 0)

(defconstant WHITE_JAK_MAX_NODES 96)

;; per node: inverse(our bind pose) x Jak's bind pose (see white-jak-build-map). A global table, not a process field:
;; 6 KB more in the process type left initialize-skeleton no heap ("art error: memory", 2026-10-15).
(deftype white-jak-fix-table (structure)
  ((m matrix 96 :inline)))

(define *white-jak-fix* (new 'global 'white-jak-fix-table))

(deftype white-jak (process-drawable)
  ((bone-map   int16 96) ;; for each of our nodes, the node in Jak's skeleton with the same joint name (-1 = none)
   (node-count int32)
   (mapped?    symbol))
  (:states
   white-jak-idle))

(defbehavior white-jak-build-map white-jak ((jak target))
  "For each of our nodes, find Jak's node whose joint has the same name. Node 0 (the root, no joint) maps to 0."
  (let ((ours (-> self node-list))
        (his (-> jak node-list))
        (missing 0))
    (set! (-> self node-count) (min (-> ours length) WHITE_JAK_MAX_NODES))
    (set! (-> self bone-map 0) 0)
    (countdown (k (+ (-> self node-count) -1))
      (let* ((i (+ k 1))
             (jt (-> ours data i joint))
             (found -1))
        (when (and jt *white-jak-by-index?* (< i (-> his length)))
          (set! found i))
        (when (and jt (< found 0))
          (dotimes (j (-> his length))
            (let ((hj (-> his data j joint))) (if (and (< found 0) hj (string= (-> hj name) (-> jt name))) (set! found j)))))
        (if (< found 0) (+! missing 1))
        (set! (-> self bone-map i) found)))
    ;; bind-pose correction. Skinning is (bind-pose x bone) (bones.gc), so for our mesh to move exactly as Jak's does,
    ;; bone_ours = inverse(bind_ours) x bind_his x bone_his. Identity wherever the two rigs agree.
    (let ((inv (new 'stack-no-clear 'matrix))
          (differ 0))
      (matrix-identity! (-> *white-jak-fix* m 0))
      (countdown (k (+ (-> self node-count) -1))
        (let* ((i (+ k 1))
               (j (-> self bone-map i)))
          (cond
            ((and (> j 0) (-> ours data i joint) (-> his data j joint))
             (matrix-4x4-inverse! inv (-> ours data i joint bind-pose))
             (matrix*! (-> *white-jak-fix* m i) inv (-> his data j joint bind-pose))
             (let ((m (-> *white-jak-fix* m i)))
               ;; count joints whose correction is not (close to) the identity
               (if (or (< (-> m vector 0 x) 0.999) (< (-> m vector 1 y) 0.999) (< (-> m vector 2 z) 0.999)
                       (< 40.96 (vector-length (-> m vector 3))))
                 (+! differ 1))))
            (else (matrix-identity! (-> *white-jak-fix* m i))))))
      (format 0 "white-jak: mapped ~D nodes (Jak has ~D), ~D unmatched, ~D with a different bind pose~%"
              (-> self node-count) (-> his length) missing differ)))
  (set! (-> self mapped?) #t)
  (none))

(defun white-jak-active? ()
  "Should the puppet show this frame? Off with the toggle, or whenever the game itself hides Jak (cutscenes)."
  (and *white-jak-on?*
       *target*
       (nonzero? (-> *target* draw))
       (not (logtest? (-> *target* draw status) (draw-status hidden no-anim)))))

(define *white-jak-white-eyes?* #t) ;; Corey: "his eyes should glow white like jak 3"

;; ---- the glow: the ending's own white-eco aura (sage-finalboss-part.gc parts 2930 / 2929, common "effects"
;; textures), tinted Light-Jak blue-white, on new ids (parts 3500+, group 1000; the game's top out at 2968 / 708).
;; The ending's sparkle "pop" function is tied to the boss arena's height, so the sparkles here just rise and fade.
(defpartgroup group-white-jak-aura
  :id 1000
  :duration (seconds 3)
  :flags (use-local-clock)
  :bounds (static-bspherem 0 0 0 64)
  :parts ((sp-item 3500) (sp-item 3502)))

(defpart 3500
  :init-specs
  ((:texture (bigpuff effects))
   (:num 0.4 0.3)
   (:x (meters -0.001) (meters 0.002))
   (:y (meters -0.001) (meters 0.002))
   (:z (meters -0.001) (meters 0.002))
   (:scale-x (meters 1.2) (meters 0.4))
   (:rot-z (degrees 0) (degrees 360))
   (:scale-y :copy scale-x)
   (:r 170.0 40.0)
   (:g 200.0 40.0)
   (:b 255.0)
   (:a 0.0)
   (:scalevel-x (meters 0.004))
   (:rotvel-z (degrees -0.3) (degrees 0.6))
   (:scalevel-y :copy scalevel-x)
   (:fade-a 0.16)
   (:accel-y (meters 0) (meters 0.00033333333))
   (:timer (seconds 0.6))
   (:flags (bit2 bit3 bit14))
   (:next-time (seconds 0.2) (seconds 0.05))
   (:next-launcher 3501)))

(defpart 3501
  :init-specs ((:fade-a -0.16)))

(defpart 3502
  :init-specs
  ((:texture (hotdot effects))
   (:num 0.5 1.0)
   (:scale-x (meters 0.08) (meters 0.12))
   (:scale-y :copy scale-x)
   (:r 210.0 45.0)
   (:g 225.0 30.0)
   (:b 255.0)
   (:a 48.0 64.0)
   (:vel-y (meters 0.01) (meters 0.02))
   (:scalevel-x (meters -0.0005))
   (:scalevel-y :copy scalevel-x)
   (:accel-y (meters 0.0005) (meters 0.0005))
   (:friction 0.9)
   (:timer (seconds 0.3) (seconds 0.4))
   (:flags (bit0 bit2 bit3 bit14))
   (:conerot-x (degrees 0) (degrees 360))
   (:conerot-y (degrees 0) (degrees 360))))

(define *white-jak-aura?* #t)

(defun white-jak-eyes ((wj white-jak) (jak target))
  "Jak 1 draws eyes into a texture per eye slot (update-eyes, eye.gc), only for a slot whose process has the eye bit and
   was drawn. Jak's merc-eye-anim fills his slot with his eye/blink data, but Jak is not drawn while the puppet stands in
   (black eyes, Corey 2026-10-15). Hand the puppet's slot to the puppet: its own eye shaders, Jak's live eye data."
  (let ((his-ctrl (-> jak draw mgeo header eye-ctrl))
        (our-ctrl (-> wj draw mgeo header eye-ctrl)))
    (when (and (nonzero? his-ctrl) (nonzero? our-ctrl))
      (let ((src (-> *eye-control-array* data (-> his-ctrl eye-slot)))
            (dst (-> *eye-control-array* data (-> our-ctrl eye-slot))))
        (when (!= src dst)
          (set! (-> dst left data 0 quad) (-> src left data 0 quad))
          (set! (-> dst left data 1 quad) (-> src left data 1 quad))
          (set! (-> dst right data 0 quad) (-> src right data 0 quad))
          (set! (-> dst right data 1 quad) (-> src right data 1 quad))
          (set! (-> dst level) (-> src level)))
        ;; Light Jak's eyes are glowing white: no iris and no pupil (render-eyes scales them by data 1 x / y)
        (when *white-jak-white-eyes?*
          (set! (-> dst left data 1 x) 0.0)
          (set! (-> dst left data 1 y) 0.0)
          (set! (-> dst right data 1 x) 0.0)
          (set! (-> dst right data 1 y) 0.0))
        (set! (-> dst process) (process->handle wj))
        (set! (-> dst shaders) (the-as (inline-array adgif-shader) (-> our-ctrl iris-shader)))
        (logior! (-> wj skel status) (janim-status eye)))))
  (none))

(define-extern white-wings-place (function target none)) ;; WHITE JAK WINGS (white-wings.gc)

(defun white-jak-postbind ((jak target))
  "Called from Jak's postbind (after his joint math, before the draw): copy his pose onto the puppet."
  (let ((wj (the-as white-jak (handle->process (-> *white-jak* handle)))))
    (when (and wj (-> wj mapped?) (white-jak-active?) (not *white-jak-own-anim?*))
      (let ((dst (-> wj node-list))
            (src (-> jak node-list)))
        (dotimes (i (-> wj node-count))
          (let ((j (-> wj bone-map i)))
            (when (>= j 0)
              (let ((d (-> dst data i bone))
                    (s (-> src data j bone)))
                (if *white-jak-fix?*
                  (matrix*! (-> d transform) (-> *white-jak-fix* m i) (-> s transform))
                  (matrix-copy! (-> d transform) (-> s transform)))
                (set! (-> d scale quad) (-> s scale quad)))))))
      (white-jak-eyes wj jak)
      ;; the renderer culls on origin + bounds
      (set! (-> wj root trans quad) (-> jak root trans quad))
      (set! (-> wj draw origin quad) (-> jak draw origin quad))
      (set! (-> wj draw light-index) (-> jak draw light-index))
      (vector*! (-> wj draw color-mult) (-> jak draw color-mult) *white-jak-mult*)
      (set! (-> wj draw color-mult w) (-> jak draw color-mult w))
      (vector+! (-> wj draw color-emissive) (-> jak draw color-emissive) *white-jak-glow*)
      (set! (-> wj draw color-emissive w) 0.0)))
  (white-wings-place jak) ;; WHITE JAK WINGS: placed after Jak's joint math too
  0
  (none))

(defstate white-jak-idle (white-jak)
  :trans
    (behavior ()
      (when (and (not (-> self mapped?)) *target*)
        (white-jak-build-map *target*))
      (cond
        (*white-jak-own-anim?*
         (logclear! (-> self draw status) (draw-status hidden no-anim no-skeleton-update))
         (set! (-> self root trans quad) (-> *target* root trans quad))
         (+! (-> self root trans x) (meters 2))
         (set! (-> self root quat quad) (-> *target* root quat quad))
         (set! *white-jak-hidden-proc* (the-as process-drawable #f)))
        ((and (-> self mapped?) (white-jak-active?))
         (logclear! (-> self draw status) (draw-status hidden no-anim no-skeleton-update))
         (set! *white-jak-hidden-proc* *target*)
         (if (and *white-jak-aura?* (nonzero? (-> self part)))
           (spawn (-> self part) (process-drawable-random-point! self (new 'stack-no-clear 'vector)))))
        (else
         (logior! (-> self draw status) (draw-status hidden))
         (set! *white-jak-hidden-proc* (the-as process-drawable #f)))))
  :code
    (behavior ()
      (ja-channel-set! 1)
      (ja :group! jak-white-idle-ja :num! min)
      (loop
        (when *white-jak-own-anim?*
          (ja :num! (loop!))
          (ja-post))
        (suspend))))

(defbehavior white-jak-init-by-other white-jak ()
  (set! (-> self root) (new 'process 'trsqv))
  (if *target* (set! (-> self root trans quad) (-> *target* root trans quad)))
  (initialize-skeleton self *white-jak-sg* '())
  ;; group-white-jak-aura: Jak 1 looks part groups up by id
  (set! (-> self part) (create-launch-control (-> *part-group-id-table* 1000) self))
  (set! (-> self mapped?) #f)
  (format 0 "white-jak: init done, ~D nodes, heap ~D bytes used~%" (-> self node-list length)
          (&- (-> self heap-cur) (-> self heap-base)))
  ;; never animated or joint-mathed itself: its bones are written by white-jak-postbind
  (logior! (-> self draw status) (draw-status hidden))
  (go white-jak-idle)
  (none))

(defmethod deactivate ((this white-jak))
  (format 0 "white-jak: puppet deactivated~%")
  ((method-of-type process-drawable deactivate) this)
  (none))

(defun white-jak-maintenance ()
  "Every frame (runs-every-frame): R3 toggles; keep one puppet alive under Jak; give Jak's mesh back when off."
  (when (cpad-pressed? 0 r3)
    (set! *white-jak-on?* (not *white-jak-on?*))
    (format 0 "white-jak: ~A~%" (if *white-jak-on?* "on" "off")))
  (cond
    ((not *target*)
     (set! *white-jak-hidden-proc* (the-as process-drawable #f)))
    ((not (handle->process (-> *white-jak* handle)))
     (set! *white-jak-hidden-proc* (the-as process-drawable #f))
     (cond
       ((> (-> *white-jak* retry) 0) (+! (-> *white-jak* retry) -1))
       (else
        (set! (-> *white-jak* retry) 60)
        (let ((p (process-spawn white-jak :to *target*)))
          (format 0 "white-jak: spawn ~A~%" (if p (-> p 0) #f))
          (if p (set! (-> *white-jak* handle) (ppointer->handle p))))))))
  (if (not *white-jak-on?*) (set! *white-jak-hidden-proc* (the-as process-drawable #f)))
  (none))
