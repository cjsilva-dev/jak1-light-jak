;;-*-Lisp-*-
(in-package goal)

;; name: light-wings.gc
;; name in dgo: light-wings
;; dgos: GAME

;; LIGHT JAK IN JAK 1, the wings: the Sentinel Beach pelican (pelican-ag, in the common fr3 and GAME.CGO) on his back
;; while he flies, Dark Flight's "Dark Angel" trick: the whole bird rides on Jak's back with every bone except the two
;; wing chains (l/rShoulder, l/rElbow, l/rHand*) shrunk into a lump at the anchor. Like the puppet it never runs its
;; own ja-post: from Jak's postbind (lj-form-postbind) lj-wings-place evaluates its animation and joint math with the
;; bird at the origin, then re-bases every bone onto Jak's chest. One full stroke of its fly loop per X press, a slow
;; drift between presses, and in a glide the same fly loop at a glide pace that follows the glide speed (the pelican's
;; own glide loop banks to one side). (The Flut Flut's wings were tried first: "not angelic", and blue.) White: the
;; decompiler whitens the feathers in the common level from the player's own pixels (jak1_config.jsonc
;; common_whiten_textures, extract_level.cpp); the real pelican on Sentinel Beach keeps its colours.

(defskelgroup *lj-wings-sg*
  pelican
  pelican-lod0-jg
  pelican-fly-ja
  ((pelican-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 6))

(defconstant LJ_MAX_WING_NODES 64)

(deftype lj-wings (process-drawable)
  ((keep        int8 64)  ;; LJ_MAX_WING_NODES: per node, 1 = a wing bone (kept), 0 = body (shrunk into the anchor)
   (node-count  int32)
   (chest-node  int32)    ;; the bird's chest: the wing bones are placed relative to it
   (beat-frames float)    ;; frames in the fly loop
   (beat        float)    ;; where in the fly loop the wings are, frames
   (mapped?     symbol)
   (shown?      symbol)
   (glide-pace? symbol))  ;; the glide's pace is showing (a change crossfades)
  (:states
   lj-wings-idle))

(defun lj-prefix? ((s string) (p string))
  "Does S start with P? (Jak 1 has no prefix test for strings.)"
  (let ((n (length p))
        (ok #t))
    (if (< (length s) n)
      (set! ok #f)
      (dotimes (i n)
        (if (!= (-> s data i) (-> p data i)) (set! ok #f))))
    ok))

(defbehavior lj-wings-map lj-wings ()
  "Once, at the spawn: which of the bird's bones are wing bones, and its chest."
  (let ((nl (-> self node-list)))
    (set! (-> self node-count) (min (-> nl length) LJ_MAX_WING_NODES))
    (if (< LJ_MAX_WING_NODES (-> nl length))
      (format 0 "light-jak: the wings have ~D bones, only ~D are placed~%" (-> nl length) LJ_MAX_WING_NODES))
    (dotimes (i (-> self node-count))
      (set! (-> self keep i) 0)
      (let ((jt (-> nl data i joint)))
        (when jt
          (let ((nm (-> jt name)))
            (if (or (string= nm "lShoulder") (string= nm "lElbow") (lj-prefix? nm "lHand")
                    (string= nm "rShoulder") (string= nm "rElbow") (lj-prefix? nm "rHand"))
              (set! (-> self keep i) 1))))))
    (set! (-> self chest-node) (lj-joint-index nl "chest"))
    (when (< (-> self chest-node) 0)
      (format 0 "light-jak: the wings have no chest bone~%")
      (set! (-> self chest-node) 0)))
  (set! (-> self mapped?) #t)
  (none))

(defun lj-wings-show? ()
  (and (-> *lj-tune* wings?) (-> *lj* flying?) (lj-form-active?)))

(defun lj-wings-place ((jak target))
  "From Jak's postbind: animate the bird at the origin, then move every bone onto Jak's back (wing bones at wing-scale,
   body bones shrunk into the anchor). Every bone is moved: a bone left behind stretches the vertices weighted between
   it and its moved neighbours across the screen (2026-10-15)."
  (let ((w (the-as lj-wings (handle->process (-> *lj* wings))))
        (t *lj-tune*))
    (when (and w (-> w shown?))
      ;; the bird's own pose, at the origin, upright. Not vector-reset!: that zeroes w too, and Jak 1's bone matrices
      ;; carry a scale in the translation's w (scale-joints divides by it); w = 0 sent every vertex to infinity.
      (set-vector! (-> w root trans) 0.0 0.0 0.0 1.0)
      (quaternion-identity! (-> w root quat))
      (evaluate-joint-control w)
      (do-joint-math! w)
      ;; the anchor: Jak's chest bone + offsets, Jak's facing (+ the glide lean), the bird's scale
      (let* ((jq (-> jak control quat))
             (up (vector-y-quaternion! (new 'stack-no-clear 'vector) jq))
             (fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) jq))
             (tq (new 'stack-no-clear 'transformq))
             (anchor (new 'stack-no-clear 'matrix))
             (m (new 'stack-no-clear 'matrix))
             (chest (new 'stack-no-clear 'vector)))
        (set! (-> tq trans quad) (-> jak node-list data (joint-node-index eichar-lod0-jg chest) bone transform vector 3 quad))
        (vector+float*! (-> tq trans) (-> tq trans) up (-> t wing-up))
        (vector+float*! (-> tq trans) (-> tq trans) fwd (- (-> t wing-back)))
        (set! (-> tq trans w) 1.0)
        (let ((lean (quaternion-axis-angle! (new 'stack-no-clear 'quaternion) 1.0 0.0 0.0 (degrees (-> *lj* body-pitch)))))
          (quaternion*! (-> tq quat) jq lean))
        (set-vector! (-> tq scale) (-> t wing-scale) (-> t wing-scale) (-> t wing-scale) 1.0)
        (matrix<-transformq! anchor tq)
        (set! (-> chest quad) (-> w node-list data (-> w chest-node) bone transform vector 3 quad))
        (dotimes (i (-> w node-count))
          (let ((b (-> w node-list data i bone)))
            (matrix-copy! m (-> b transform))
            (cond
              ((= (-> w keep i) 1)
               ;; a wing bone: relative to the bird's chest
               (vector-! (-> m vector 3) (-> m vector 3) chest)
               (set! (-> m vector 3 w) 1.0))
              (else
               ;; a body bone: shrunk and collapsed onto the anchor. vector-float*! sets w = 1, and an axis row with
               ;; w = 1 pulls the anchor's position into every vertex: axis rows keep w = 0.
               (vector-float*! (-> m vector 0) (-> m vector 0) (-> t wing-shrink))
               (vector-float*! (-> m vector 1) (-> m vector 1) (-> t wing-shrink))
               (vector-float*! (-> m vector 2) (-> m vector 2) (-> t wing-shrink))
               (set! (-> m vector 0 w) 0.0)
               (set! (-> m vector 1 w) 0.0)
               (set! (-> m vector 2 w) 0.0)
               (set-vector! (-> m vector 3) 0.0 0.0 0.0 1.0)))
            (matrix*! (-> b transform) m anchor)))
        (set! (-> w root trans quad) (-> tq trans quad))
        (set! (-> w draw origin quad) (-> tq trans quad))
        (lj-draw-like! w jak (-> t wing-mult) (-> t wing-glow)))))
  (none))

(defbehavior lj-wings-show! lj-wings ((on? symbol))
  (set! (-> self shown?) on?)
  (lj-draw-show! self on?)
  (none))

(defstate lj-wings-idle (lj-wings)
  :trans
    (behavior ()
      (let ((want (if (and (-> self mapped?) (lj-wings-show?)) #t #f)))
        (if (!= want (-> self shown?)) (lj-wings-show! want))))
  :code
    (behavior ()
      (ja-channel-set! 1)
      (ja :group! pelican-fly-ja :num! min)
      (loop
        (when (-> self shown?)
          (let* ((t *lj-tune*)
                 (since (- (current-time) (-> *lj* flap-time)))
                 (gliding? (-> *lj* gliding?))
                 (n (-> self beat-frames))
                 (stroke (lj-seconds (-> t wing-stroke)))
                 (stroking? (and (not gliding?) (< since (-> t wing-stroke))))
                 (fps (if stroking? (/ n stroke) (-> t wing-idle-fps)))
                 (beat (cond
                         ;; gliding: the fly loop keeps going, its pace following the glide speed
                         (gliding? (+ (-> self beat)
                                      (* (-> t wing-glide-fps) (seconds-per-frame)
                                         (fmax (-> t wing-glide-min)
                                               (fmin (-> t wing-glide-max) (/ (-> *lj* glide-speed) (-> t glide-cruise)))))))
                         ((< since (-> t flap-fresh)) 0.0) ;; a new press: the stroke starts over
                         (else (+ (-> self beat) (* fps (seconds-per-frame)))))))
            (if (< beat 0.0) (set! beat (+ beat n)))
            (if (>= beat n) (set! beat (- beat (* n (the float (the int (/ beat n)))))))
            ;; a glide starts or ends: the pace and phase change, so crossfade (lj-wings-place's evaluate-joint-control
            ;; runs it); out of a glide the stroke starts over
            (when (!= gliding? (-> self glide-pace?))
              (set! (-> self glide-pace?) gliding?)
              (if (not gliding?) (set! beat 0.0))
              (ja-channel-push! 1 (-> t wing-blend)))
            (set! (-> self beat) beat)
            (ja :group! pelican-fly-ja :num! (identity beat))))
        (suspend))))

(defbehavior lj-wings-init-by-other lj-wings ((jak target))
  "Spawned with the puppet (lj-form-spawn), a child of Jak."
  ;; the flags first: initialize-skeleton goes to process-drawable-art-error on missing art, and wings left there must
  ;; read as not mapped and not shown (lj-wings-place skips them)
  (set! (-> self mapped?) #f)
  (set! (-> self shown?) #f)
  (set! (-> self glide-pace?) #f)
  (set! (-> self beat) 0.0)
  (set! (-> self root) (new 'process 'trsqv))
  ;; a new trsqv's scale is zero: the bird's joint math then makes zero-scale bones, whose normal matrices divide by zero
  (vector-identity! (-> self root scale))
  (initialize-skeleton self *lj-wings-sg* '())
  (set! (-> self beat-frames) (the float (+ -1 (-> (the-as art-joint-anim pelican-fly-ja) data 0 length))))
  (lj-wings-map)
  (logior! (-> self draw status) (draw-status hidden))
  (go lj-wings-idle)
  (none))
